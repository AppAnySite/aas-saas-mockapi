########################################################
# SERVICE & ROUTING
########################################################
NODE_ENV=development
LOG_LEVEL=debug
BASE_PATH=/internal/api
API_VERSION=v1

########################################################
# AUTH / JWT
########################################################
SECRET_KEY=dev-secret-key
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

########################################################
# SECURITY
########################################################
SECURITY_HMAC_SECRET=your-hmac-secret
SECURITY_API_KEYS=anon-api-key-123,reg-api-key-456
SECURITY_IP_WHITELIST=127.0.0.1,192.168.1.0/24

########################################################
# REDIS CACHE
########################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dummyRedisPassword
CACHE_TTL_APP=3600
CACHE_TTL_APPS_OWNER=1800
CACHE_TTL_APPS_ALL=600

########################################################
# RABBITMQ
########################################################
RABBITMQ_URL=amqp://rabbitmqUser:rabbitmqPass@rabbitmq:5672
RABBITMQ_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_MAX_QUEUE_LEN=10000
RABBITMQ_QUEUE_TTL_MS=30000
RABBITMQ_TLS_CERT=/run/secrets/rabbitmq_cert.pem
RABBITMQ_TLS_KEY=/run/secrets/rabbitmq_key.pem
RABBITMQ_TLS_CA=/run/secrets/ca_cert.pem

########################################################
# HEADER VALIDATION
########################################################
# Supported schema versions for custom headers
HEADER_SUPPORTED_SCHEMA_VERSIONS=v1
HEADER_MAX_TOTAL_SIZE=8192

########################################################
# PAYLOAD SIZE LIMITS
########################################################
PAYLOAD_MAX_SIZE=100kb

########################################################
# PROMETHEUS METRICS
########################################################
METRICS_ALLOWED_IPS=127.0.0.1 

########################################################
# RATE LIMITING
########################################################
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OLD_WINDOW_MS=300000
RATE_LIMIT_OLD_MAX_REQUESTS=20
RATE_LIMIT_SUSPICIOUS_MAX_REQUESTS=5

########################################################
# RETRY POLICY
########################################################
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=10000

########################################################
# CIRCUIT BREAKER
########################################################
CB_THRESHOLD=5
CB_TIMEOUT_MS=10000

########################################################
# CONCURRENCY (BULKHEAD)
########################################################
CONCURRENCY_MAX=10

########################################################
# LOKI LOGGING
########################################################
LOKI_ENABLED=true
LOKI_HOST=http://loki:3100

########################################################
# PRISMA CLIENT
########################################################
PRISMA_POOL_SIZE=10
PRISMA_SOCKET_TIMEOUT_MS=30000

########################################################
# MAILER
########################################################
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@localhost
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_MAX_SEND_ATTEMPTS=3
MAIL_SEND_RETRY_DELAY_MS=1000

########################################################
# JAEGER TRACING
########################################################
JAEGER_SAMPLER_PARAM=0.1
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832

########################################################
# HTTP CLIENT
########################################################
HTTP_TIMEOUT=5000

########################################################
# OBSERVABILITY
########################################################
OBSERVABILITY_SLOW_REQUEST_THRESHOLD=200

########################################################
# MOCK RESPONSES (for testing)
########################################################
MOCK_RESPONSES={}

########################################################
# CORS
########################################################
CORS_WHITELIST_URLS= http://localhost:3000,http://localhost:3001

########################################################
# FEATURE FLAGS
########################################################
FEATURE_FLAGS={"betaFeature":true}

########################################################
# FALLBACK
########################################################
FALLBACK_ENABLE=false

########################################################
# KONG PROXY
########################################################
KONG_PROXY_URL=http://kong:8000

########################################################
# DATABASE (MongoDB)
########################################################
MONGO_ROOT_URL=mongodb://mongodb:27017/?directConnection=true
DB_NAME_FEMUXER=aas-saas-femux-dev
DB_NAME_GATEWAY=aas-saas-gateway-dev
DB_NAME_BEDEMUXER=aas-saas-bedemux-dev
DB_NAME_INFRASIM=aas-saas-infrasim-dev
DB_NAME_AUTH=aas-saas-auth-dev
DB_NAME_USER=aas-saas-user-dev
DB_NAME_PERMISSION=aas-saas-permission-dev
DB_NAME_ASSET=aas-saas-asset-dev
DB_NAME_APPGEN=aas-saas-appgen-dev
DB_NAME_ICONGEN=aas-saas-icongen-dev
DB_NAME_SPLASHGEN=aas-saas-splashgen-dev
DB_NAME_BUILDER=aas-saas-builder-dev
DB_NAME_ARCHIVER=aas-saas-archiver-dev
DB_NAME_LOGGER=aas-saas-logger-dev
DB_NAME_MAILGEN=aas-saas-mailgen-dev

########################################################
# SERVICE PORTS
########################################################
FEMUXER_PORT=5050
GATEWAY_PORT=5051
BEDEMUXER_PORT=5052
INFRASIM_PORT=5053
AUTH_PORT=6060
USER_PORT=6061
PERMISSION_PORT=6062
ASSET_PORT=6063
APPGEN_PORT=6066
ICONGEN_PORT=6067
SPLASHGEN_PORT=6068
BUILDER_PORT=6069
ARCHIVER_PORT=6070
MAILGEN_PORT=6071
LOGGER_PORT=6072
MOCKAPI_PORT=3002
DEVPORTAL_PORT=3000
ADMINPORTAL_PORT=3001
LANDING_PORT=15050

########################################################
# SERVICE IDENTIFIERS
########################################################
FEMUXER_SERVICE_NAME=femux
BEDEMUXER_SERVICE_NAME=bedemux
APPGEN_SERVICE_NAME=appgen
LOGGER_SERVICE_NAME=logger
MAILGEN_SERVICE_NAME=mailgen


########################################################
# STORAGE / FILE ROTATION
########################################################
STORAGE_FILE_MAX_MB=100
STORAGE_RETENTION_DAYS=7

########################################################
# FILE‐BASED LOGS (where to write + when to roll)
########################################################
LOGS_PATH=logs
LOGS_MAX_FILE_SIZE=10485760

########################################################
# PERSISTENCE TTL (for DB‐backed logs)
########################################################
LOG_TTL_HOURS=168

########################################################
# GRPC CONNECTIVITY
########################################################
# gRPC server bind address for all services
APPGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AUTH_GRPC_SERVER_ADDRESS=0.0.0.0:50055
USER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
PERMISSION_GRPC_SERVER_ADDRESS=0.0.0.0:50055
ASSET_GRPC_SERVER_ADDRESS=0.0.0.0:50055
ICONGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
SPLASHGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
BUILDER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
ARCHIVER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
MAILGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
# gRPC client target
APPGEN_GRPC_CLIENT_ADDRESS=aas-saas-appgen:50055
AUTH_GRPC_CLIENT_ADDRESS=aas-saas-auth:50055
USER_GRPC_CLIENT_ADDRESS=aas-saas-user:50055
PERMISSION_GRPC_CLIENT_ADDRESS=aas-saas-permission:50055
ASSET_GRPC_CLIENT_ADDRESS=aas-saas-asset:50055
ICONGEN_GRPC_CLIENT_ADDRESS=aas-saas-icongen:50055
SPLASHGEN_GRPC_CLIENT_ADDRESS=aas-saas-splashgen:50055
BUILDER_GRPC_CLIENT_ADDRESS=aas-saas-builder:50055
ARCHIVER_GRPC_CLIENT_ADDRESS=aas-saas-archiver:50055
MAILGEN_GRPC_CLIENT_ADDRESS=aas-saas-mailgen:50055
# Paths to TLS certificates (in Docker secrets)
GRPC_TLS_CERT=/run/secrets/grpc_cert.pem
GRPC_TLS_KEY=/run/secrets/grpc_key.pem
GRPC_TLS_CA=/run/secrets/ca_cert.pem

########################################################
# JAEGER SERVICE NAMES
########################################################
JAEGER_SERVICE_NAME_FEMUXER=aas-saas-femux-dev
JAEGER_SERVICE_NAME_GATEWAY=aas-saas-gateway-dev
JAEGER_SERVICE_NAME_BEDEMUXER=aas-saas-bedemux-dev
JAEGER_SERVICE_NAME_INFRASIM=aas-saas-infrasim-dev
JAEGER_SERVICE_NAME_AUTH=aas-saas-auth-dev
JAEGER_SERVICE_NAME_USER=aas-saas-user-dev
JAEGER_SERVICE_NAME_PERMISSION=aas-saas-permission-dev
JAEGER_SERVICE_NAME_ASSET=aas-saas-asset-dev
JAEGER_SERVICE_NAME_APPGEN=aas-saas-appgen-dev
JAEGER_SERVICE_NAME_ICONGEN=aas-saas-icongen-dev
JAEGER_SERVICE_NAME_SPLASHGEN=aas-saas-splashgen-dev
JAEGER_SERVICE_NAME_BUILDER=aas-saas-builder-dev
JAEGER_SERVICE_NAME_ARCHIVER=aas-saas-archiver-dev
JAEGER_SERVICE_NAME_MAILGEN=aas-saas-mailgen-dev
JAEGER_SERVICE_NAME_LOGGER=aas-saas-logger-dev

########################################################
# LOKI JOB NAMES
########################################################
LOKI_JOB_NAME_FEMUXER=aas-saas-femux-dev
LOKI_JOB_NAME_GATEWAY=aas-saas-gateway-dev
LOKI_JOB_NAME_BEDEMUXER=aas-saas-bedemux-dev
LOKI_JOB_NAME_INFRASIM=aas-saas-infrasim-dev
LOKI_JOB_NAME_AUTH=aas-saas-auth-dev
LOKI_JOB_NAME_USER=aas-saas-user-dev
LOKI_JOB_NAME_PERMISSION=aas-saas-permission-dev
LOKI_JOB_NAME_ASSET=aas-saas-asset-dev
LOKI_JOB_NAME_APPGEN=aas-saas-appgen-dev
LOKI_JOB_NAME_ICONGEN=aas-saas-icongen-dev
LOKI_JOB_NAME_SPLASHGEN=aas-saas-splashgen-dev
LOKI_JOB_NAME_BUILDER=aas-saas-builder-dev
LOKI_JOB_NAME_ARCHIVER=aas-saas-archiver-dev
LOKI_JOB_NAME_MAILGEN=aas-saas-mailgen-dev
LOKI_JOB_NAME_LOGGER=aas-saas-logger-dev

########################################################
# SENTRY (optional)
########################################################
# DSN for Sentry error reporting (leave blank to disable)
SENTRY_DSN=