########################################################
# SERVICE & ROUTING
########################################################
AAS_ENV=development
AAS_LOG_LEVEL=debug
AAS_BASE_PATH=/internal/api
AAS_API_VERSION=v1

########################################################
# AUTH / JWT
########################################################
AAS_SECRET_KEY=dev-secret-key
AAS_JWT_ACCESS_EXPIRATION=3600
AAS_JWT_REFRESH_EXPIRATION=604800

########################################################
# SECURITY
########################################################
AAS_SECURITY_HMAC_SECRET=your-hmac-secret
AAS_SECURITY_API_KEYS=anon-api-key-123,reg-api-key-456
AAS_SECURITY_IP_WHITELIST=127.0.0.1,192.168.1.0/24

########################################################
# REDIS CACHE
########################################################
AAS_REDIS_HOST=redis
AAS_REDIS_PORT=6379
AAS_REDIS_PASSWORD=dummyRedisPassword
AAS_CACHE_TTL_APP=3600
AAS_CACHE_TTL_APPS_OWNER=1800
AAS_CACHE_TTL_APPS_ALL=600

########################################################
# RABBITMQ
########################################################
AAS_RABBITMQ_URL=amqp://rabbitmqUser:rabbitmqPass@rabbitmq:5672
AAS_RABBITMQ_CONFIRM_TIMEOUT_MS=5000
AAS_RABBITMQ_MAX_QUEUE_LEN=10000
AAS_RABBITMQ_QUEUE_TTL_MS=30000
AAS_RABBITMQ_TLS_CERT=/run/secrets/rabbitmq_cert.pem
AAS_RABBITMQ_TLS_KEY=/run/secrets/rabbitmq_key.pem
AAS_RABBITMQ_TLS_CA=/run/secrets/ca_cert.pem

########################################################
# HEADER VALIDATION
########################################################
# Supported schema versions for custom headers
AAS_HEADER_SUPPORTED_SCHEMA_VERSIONS=v1
AAS_HEADER_MAX_TOTAL_SIZE=8192

########################################################
# PAYLOAD SIZE LIMITS
########################################################
AAS_PAYLOAD_MAX_SIZE=100kb

########################################################
# PROMETHEUS METRICS
########################################################
AAS_METRICS_ALLOWED_IPS=127.0.0.1 

########################################################
# RATE LIMITING
########################################################
AAS_RATE_LIMIT_WINDOW_MS=900000
AAS_RATE_LIMIT_MAX_REQUESTS=100
AAS_RATE_LIMIT_OLD_WINDOW_MS=300000
AAS_RATE_LIMIT_OLD_MAX_REQUESTS=20
AAS_RATE_LIMIT_SUSPICIOUS_MAX_REQUESTS=5

########################################################
# RETRY POLICY
########################################################
AAS_RETRY_MAX_ATTEMPTS=3
AAS_RETRY_BASE_DELAY_MS=100
AAS_RETRY_MAX_DELAY_MS=10000

########################################################
# CIRCUIT BREAKER
########################################################
AAS_CB_THRESHOLD=5
AAS_CB_TIMEOUT_MS=10000

########################################################
# CONCURRENCY (BULKHEAD)
########################################################
AAS_CONCURRENCY_MAX=10

########################################################
# LOKI LOGGING
########################################################
AAS_LOKI_ENABLED=true
AAS_LOKI_HOST=http://loki:3100

########################################################
# PRISMA CLIENT
########################################################
AAS_PRISMA_POOL_SIZE=10
AAS_PRISMA_SOCKET_TIMEOUT_MS=30000

########################################################
# MAILER
########################################################
AAS_MAIL_HOST=mailhog
AAS_MAIL_PORT=1025
AAS_MAIL_FROM=noreply@localhost
AAS_MAIL_SECURE=false
AAS_MAIL_USER=
AAS_MAIL_PASS=
AAS_MAIL_MAX_SEND_ATTEMPTS=3
AAS_MAIL_SEND_RETRY_DELAY_MS=1000

########################################################
# JAEGER TRACING
########################################################
AAS_JAEGER_SAMPLER_PARAM=0.1
AAS_JAEGER_AGENT_HOST=localhost
AAS_JAEGER_AGENT_PORT=6832

########################################################
# HTTP CLIENT
########################################################
AAS_HTTP_TIMEOUT=5000

########################################################
# OBSERVABILITY
########################################################
AAS_OBSERVABILITY_SLOW_REQUEST_THRESHOLD=200

########################################################
# MOCK RESPONSES (for testing)
########################################################
AAS_MOCK_RESPONSES={}

########################################################
# CORS
########################################################
AAS_CORS_WHITELIST_URLS= http://localhost:3000,http://localhost:3001

########################################################
# FEATURE FLAGS
########################################################
FEATURE_FLAGS={"betaFeature":true}

########################################################
# FALLBACK
########################################################
AAS_FALLBACK_ENABLE=false

########################################################
# KONG PROXY
########################################################
AAS_KONG_PROXY_URL=http://kong:8000

########################################################
# DATABASE (MongoDB)
########################################################
AAS_MONGO_ROOT_URL=mongodb://mongodb:27017/?directConnection=true
AAS_DB_NAME_FEMUXER=aas-saas-femux-dev
AAS_DB_NAME_GATEWAY=aas-saas-gateway-dev
AAS_DB_NAME_BEDEMUXER=aas-saas-bedemux-dev
AAS_DB_NAME_INFRASIM=aas-saas-infrasim-dev
AAS_DB_NAME_AUTH=aas-saas-auth-dev
AAS_DB_NAME_USER=aas-saas-user-dev
AAS_DB_NAME_PERMISSION=aas-saas-permission-dev
AAS_DB_NAME_ASSET=aas-saas-asset-dev
AAS_DB_NAME_APPGEN=aas-saas-appgen-dev
AAS_DB_NAME_ICONGEN=aas-saas-icongen-dev
DB_NAME_SPLASHGEN=aas-saas-splashgen-dev
AAS_DB_NAME_BUILDER=aas-saas-builder-dev
AAS_DB_NAME_ARCHIVER=aas-saas-archiver-dev
AAS_DB_NAME_LOGGER=aas-saas-logger-dev
AAS_DB_NAME_MAILGEN=aas-saas-mailgen-dev

########################################################
# SERVICE PORTS
########################################################
AAS_FEMUXER_PORT=5050
AAS_GATEWAY_PORT=5051
AAS_BEDEMUXER_PORT=5052
AAS_INFRASIM_PORT=5053
AAS_AUTH_PORT=6060
AAS_USER_PORT=6061
AAS_PERMISSION_PORT=6062
AAS_ASSET_PORT=6063
AAS_APPGEN_PORT=6066
AAS_ICONGEN_PORT=6067
AAS_SPLASHGEN_PORT=6068
AAS_BUILDER_PORT=6069
AAS_ARCHIVER_PORT=6070
AAS_MAILGEN_PORT=6071
AAS_LOGGER_PORT=6072
AAS_MOCKAPI_PORT=3002
AAS_DEVPORTAL_PORT=3000
AAS_ADMINPORTAL_PORT=3001
AAS_LANDING_PORT=15050

########################################################
# SERVICE IDENTIFIERS
########################################################
AAS_FEMUXER_SERVICE_NAME=femux
AAS_BEDEMUXER_SERVICE_NAME=bedemux
AAS_APPGEN_SERVICE_NAME=appgen
AAS_LOGGER_SERVICE_NAME=logger
AAS_MAILGEN_SERVICE_NAME=mailgen


########################################################
# STORAGE / FILE ROTATION
########################################################
AAS_STORAGE_FILE_MAX_MB=100
AAS_STORAGE_RETENTION_DAYS=7

########################################################
# FILE‐BASED LOGS (where to write + when to roll)
########################################################
AAS_LOGS_PATH=logs
AAS_LOGS_MAX_FILE_SIZE=10485760

########################################################
# PERSISTENCE TTL (for DB‐backed logs)
########################################################
AAS_LOG_TTL_HOURS=168

########################################################
# GRPC CONNECTIVITY
########################################################
# gRPC server bind address for all services
AAS_APPGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_AUTH_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_USER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_PERMISSION_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_ASSET_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_ICONGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_SPLASHGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_BUILDER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_ARCHIVER_GRPC_SERVER_ADDRESS=0.0.0.0:50055
AAS_MAILGEN_GRPC_SERVER_ADDRESS=0.0.0.0:50055
# gRPC client target
AAS_APPGEN_GRPC_CLIENT_ADDRESS=aas-saas-appgen:50055
AAS_AUTH_GRPC_CLIENT_ADDRESS=aas-saas-auth:50055
AAS_USER_GRPC_CLIENT_ADDRESS=aas-saas-user:50055
AAS_PERMISSION_GRPC_CLIENT_ADDRESS=aas-saas-permission:50055
AAS_ASSET_GRPC_CLIENT_ADDRESS=aas-saas-asset:50055
AAS_ICONGEN_GRPC_CLIENT_ADDRESS=aas-saas-icongen:50055
AAS_SPLASHGEN_GRPC_CLIENT_ADDRESS=aas-saas-splashgen:50055
AAS_BUILDER_GRPC_CLIENT_ADDRESS=aas-saas-builder:50055
AAS_ARCHIVER_GRPC_CLIENT_ADDRESS=aas-saas-archiver:50055
AAS_MAILGEN_GRPC_CLIENT_ADDRESS=aas-saas-mailgen:50055
# Paths to TLS certificates (in Docker secrets)
AAS_GRPC_TLS_CERT=/run/secrets/grpc_cert.pem
AAS_GRPC_TLS_KEY=/run/secrets/grpc_key.pem
AAS_GRPC_TLS_CA=/run/secrets/ca_cert.pem

########################################################
# JAEGER SERVICE NAMES
########################################################
AAS_JAEGER_SERVICE_NAME_FEMUXER=aas-saas-femux-dev
AAS_JAEGER_SERVICE_NAME_GATEWAY=aas-saas-gateway-dev
AAS_JAEGER_SERVICE_NAME_BEDEMUXER=aas-saas-bedemux-dev
AAS_JAEGER_SERVICE_NAME_INFRASIM=aas-saas-infrasim-dev
AAS_JAEGER_SERVICE_NAME_AUTH=aas-saas-auth-dev
AAS_JAEGER_SERVICE_NAME_USER=aas-saas-user-dev
AAS_JAEGER_SERVICE_NAME_PERMISSION=aas-saas-permission-dev
AAS_JAEGER_SERVICE_NAME_ASSET=aas-saas-asset-dev
AAS_JAEGER_SERVICE_NAME_APPGEN=aas-saas-appgen-dev
AAS_JAEGER_SERVICE_NAME_ICONGEN=aas-saas-icongen-dev
AAS_JAEGER_SERVICE_NAME_SPLASHGEN=aas-saas-splashgen-dev
AAS_JAEGER_SERVICE_NAME_BUILDER=aas-saas-builder-dev
AAS_JAEGER_SERVICE_NAME_ARCHIVER=aas-saas-archiver-dev
AAS_JAEGER_SERVICE_NAME_MAILGEN=aas-saas-mailgen-dev
AAS_JAEGER_SERVICE_NAME_LOGGER=aas-saas-logger-dev

########################################################
# LOKI JOB NAMES
########################################################
AAS_LOKI_JOB_NAME_FEMUXER=aas-saas-femux-dev
AAS_LOKI_JOB_NAME_GATEWAY=aas-saas-gateway-dev
AAS_LOKI_JOB_NAME_BEDEMUXER=aas-saas-bedemux-dev
AAS_LOKI_JOB_NAME_INFRASIM=aas-saas-infrasim-dev
AAS_LOKI_JOB_NAME_AUTH=aas-saas-auth-dev
AAS_LOKI_JOB_NAME_USER=aas-saas-user-dev
AAS_LOKI_JOB_NAME_PERMISSION=aas-saas-permission-dev
AAS_LOKI_JOB_NAME_ASSET=aas-saas-asset-dev
AAS_LOKI_JOB_NAME_APPGEN=aas-saas-appgen-dev
AAS_LOKI_JOB_NAME_ICONGEN=aas-saas-icongen-dev
AAS_LOKI_JOB_NAME_SPLASHGEN=aas-saas-splashgen-dev
AAS_LOKI_JOB_NAME_BUILDER=aas-saas-builder-dev
AAS_LOKI_JOB_NAME_ARCHIVER=aas-saas-archiver-dev
AAS_LOKI_JOB_NAME_MAILGEN=aas-saas-mailgen-dev
AAS_LOKI_JOB_NAME_LOGGER=aas-saas-logger-dev

########################################################
# SENTRY (optional)
########################################################
# DSN for Sentry error reporting (leave blank to disable)
AAS_SENTRY_DSN=